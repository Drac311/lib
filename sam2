-- ── Simulación de tecla E (hold) ───────────────────────────
local function simulateEHold(holdDuration)
    holdDuration = holdDuration or 1.5
    local methodsTried = {}
    local hexE = 0x45

    -- Método 1: keypress/keyrelease global (string)
    if type(keypress) == "function" and type(keyrelease) == "function" then
        local ok = pcall(function()
            keypress("E")
            task.wait(holdDuration)
            keyrelease("E")
        end)
        table.insert(methodsTried, "keypress(str):" .. tostring(ok))
        if ok then return "keypress(str)" end

        ok = pcall(function()
            keypress(hexE)
            task.wait(holdDuration)
            keyrelease(hexE)
        end)
        table.insert(methodsTried, "keypress(hex):" .. tostring(ok))
        if ok then return "keypress(hex)" end
    end

    -- Método 2: syn
    if syn and syn.KeyPress and syn.KeyRelease then
        local ok = pcall(function()
            syn.KeyPress("E")
            task.wait(holdDuration)
            syn.KeyRelease("E")
        end)
        table.insert(methodsTried, "syn.KeyPress:" .. tostring(ok))
        if ok then return "syn.KeyPress" end
    end

    -- Método 3: VirtualInputManager
    local vim = game:GetService("VirtualInputManager")
    if vim and vim.SendKeyEvent then
        local ok = pcall(function()
            vim:SendKeyEvent(true, Enum.KeyCode.E, false, game)
            task.wait(holdDuration)
            vim:SendKeyEvent(false, Enum.KeyCode.E, false, game)
        end)
        table.insert(methodsTried, "VIM:" .. tostring(ok))
        if ok then return "VIM" end
    end

    -- Método 4: InputHoldBegin/End directo
    local ok = pcall(function()
        -- Nota: esta función solo dispara si el prompt está listo
        -- No se llama aquí porque el user pidió "E simulada"
    end)
    table.insert(methodsTried, "fallback:InputHold")
    return nil, methodsTried
end

