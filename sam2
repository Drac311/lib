task.spawn(function()
    task.wait(5)
    while task.wait(5) do
        local entry, val = findBestBrainrot("value")

        if S.autoServerHop and not isHopping and not isStealing then
            if not entry or val < S.minBrainrotValue then
                isHopping = true
                S.lastNotified = ""
                local displayVal = val > 0 and formatNumber(val) or "Ninguno"
                local displayMin = formatNumber(S.minBrainrotValue)
                Window:Notify({
                    Title = "Auto Server Hop",
                    Content = "Mejor ("..displayVal..") < Mínimo ("..displayMin.."). Cambiando en 6s...",
                    Duration = 6
                })
                local t = 0
