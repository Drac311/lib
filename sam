-- ── Funciones de Texto a Número ──────────────────────────────
local function parseValueString(inputStr)
    if type(inputStr) == "number" then return inputStr end
    if not inputStr or inputStr == "" then return 0 end
    
    local cleanStr = tostring(inputStr):gsub("[^%w%.%-]", "")
    cleanStr = cleanStr:upper()
    
    local multipliers = {
        K = 1e3,
        M = 1e6,
        B = 1e9,
        T = 1e12
    }
    
    local suffix = cleanStr:match("([KMBT])$")
    local numStr = cleanStr
    
    if suffix then
        numStr = cleanStr:sub(1, -2)
    end
    
    local num = tonumber(numStr)
    if not num then return 0 end
    
    if suffix and multipliers[suffix] then
        num = num * multipliers[suffix]
    end
    
    return math.floor(num)
end

local function formatNumber(n)
    if n >= 1e12 then return string.format("%.1fT", n/1e12)
    elseif n >= 1e9 then return string.format("%.1fB", n/1e9)
    elseif n >= 1e6 then return string.format("%.1fM", n/1e6)
    elseif n >= 1e3 then return string.format("%.1fK", n/1e3)
    else return tostring(math.floor(n)) end
end

