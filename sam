end

local function isInFusion(model)
    if not model or not model.Parent then return true end

    local partCount = 0
    local transCount = 0
    for _, p in ipairs(model:GetDescendants()) do
        if p:IsA("BasePart") then
            partCount = partCount + 1
            if p.Transparency > 0.1 and p.Transparency < 0.99 then
                transCount = transCount + 1
            end
        end
    end
    if partCount > 0 and (transCount / partCount) > 0.3 then
        return true
    end

    local prompt = model:FindFirstChildWhichIsA("ProximityPrompt", true)
    if prompt and not prompt.Enabled then return true end

    if model:GetAttribute("InFusion") or model:GetAttribute("Fusing") then return true end

    for _, gui in ipairs(model:GetDescendants()) do
        if gui:IsA("BillboardGui") or gui:IsA("SurfaceGui") then
            for _, txt in ipairs(gui:GetDescendants()) do
                if txt:IsA("TextLabel") then
                    local t = txt.Text:lower()
                    if t:find("fusion") or t:find("fusing") then
                        return true
                    end
                end
            end
        end
    end

    return false
end

local function getMyPlot()
    local plotsFolder = workspace:FindFirstChild("Plots")
    if not plotsFolder then return nil end

    local plotId = LP:GetAttribute("PlotId") or LP:GetAttribute("Plot") or LP:GetAttribute("PlotName") or LP:GetAttribute("OwnedPlot")
    if plotId then
        local p = plotsFolder:FindFirstChild(tostring(plotId))
        if p then return p end
        for _, plot in ipairs(plotsFolder:GetChildren()) do
            if plot:GetAttribute("PlotId") == plotId or plot:GetAttribute("Id") == plotId or plot:GetAttribute("Owner") == plotId then 
                return plot 
            end
        end
    end

    local plotValue = LP:FindFirstChild("Plot") or LP:FindFirstChild("PlotObject") or LP:FindFirstChild("House") or LP:FindFirstChild("Base")
    if plotValue then
        if plotValue:IsA("ObjectValue") and plotValue.Value then
            return plotValue.Value
        elseif plotValue:IsA("StringValue") then
            local p = plotsFolder:FindFirstChild(plotValue.Value)
            if p then return p end
        end
    end

    for _, plot in ipairs(plotsFolder:GetChildren()) do
        if plot:GetAttribute("Owner") == LP.Name or plot:GetAttribute("OwnerId") == LP.UserId or plot:GetAttribute("Player") == LP.Name or plot:GetAttribute("PlayerId") == LP.UserId then
            return plot
        end
        
        for _, child in ipairs(plot:GetDescendants()) do
            if child:IsA("StringValue") and (child.Value == LP.Name or child.Value == tostring(LP.UserId)) then 
                return plot 
            elseif child:IsA("NumberValue") and child.Value == LP.UserId then
                return plot
            elseif child:IsA("ObjectValue") and child.Value == LP then
                return plot
            end
        end
        
        if plot.Name:lower():find(LP.Name:lower()) or plot.Name == tostring(LP.UserId) then
            return plot
        end
    end

    local char = LP.Character
    if char and char:FindFirstChild("HumanoidRootPart") then
        local hrpPos = char.HumanoidRootPart.Position
        local closestPlot = nil
        local shortestDist = math.huge
        for _, plot in ipairs(plotsFolder:GetChildren()) do
            local pos = plot:GetPivot().Position
            if plot.PrimaryPart then pos = plot.PrimaryPart.Position end
            local dist = (pos - hrpPos).Magnitude
            if dist < 100 and dist < shortestDist then
                shortestDist = dist
                closestPlot = plot
            end
        end
        if closestPlot then return closestPlot end
    end

    if S.myBasePos then
        local closestPlot = nil
        local shortestDist = math.huge
        for _, plot in ipairs(plotsFolder:GetChildren()) do
            local pos = plot:GetPivot().Position
            if plot.PrimaryPart then pos = plot.PrimaryPart.Position end
            local dist = (pos - S.myBasePos).Magnitude
            if dist < shortestDist and dist < 150 then
                shortestDist = dist
                closestPlot = plot
            end
        end
        if closestPlot then return closestPlot end
    end

    return nil
end

local function getPlotFloor(myPlot)
    local lowestY = math.huge
    local baseX, baseZ = myPlot:GetPivot().X, myPlot:GetPivot().Z
    
    for _, part in ipairs(myPlot:GetDescendants()) do
        if part:IsA("BasePart") and not part:IsDescendantOf(LP.Character) then
            if part.Size.X > 15 and part.Size.Z > 15 then
                if part.Position.Y < lowestY then
                    lowestY = part.Position.Y
                    baseX = part.Position.X
                    baseZ = part.Position.Z
                end
            end
        end
    end
    
    if lowestY == math.huge then return myPlot:GetPivot().Position end
    return Vector3.new(baseX, lowestY + 3, baseZ)
end

local function getGroundY(posX, posZ)
    local rayParams = RaycastParams.new()
    rayParams.FilterType = Enum.RaycastFilterType.Exclude
    local plotsFolder = workspace:FindFirstChild("Plots")
    rayParams.FilterDescendantsInstances = {LP.Character, plotsFolder}
    
    local rayOrigin = Vector3.new(posX, 1000, posZ)
    local rayDir = Vector3.new(0, -2000, 0)
    local result = workspace:Raycast(rayOrigin, rayDir, rayParams)
    if result then
        return result.Position.Y
    end
    return 0
end

local function findBestBrainrot()
    local myPlot = getMyPlot()
    local highestValue = -1
    local bestModel = nil
    local plotsFolder = workspace:FindFirstChild("Plots")
    local searchArea = plotsFolder or workspace
    
    for _, obj in ipairs(searchArea:GetDescendants()) do
        if obj:IsA("Model") then
            if myPlot and obj:IsDescendantOf(myPlot) then continue end
            
            if obj:FindFirstChildOfClass("Humanoid") or obj.PrimaryPart then
                if AnimalData[obj.Name] or obj:GetAttribute("Brainrot") or obj:FindFirstChild("Price") then
                    if not isInFusion(obj) then
                        local val = getBrainrotValue(obj)
                        if val > highestValue then
                            highestValue = val
                            bestModel = obj
                        end
                    end
                end
            end
        end
    end
    return bestModel, highestValue
end

local function getOwnerName(plotModel)
    local parent = plotModel.Parent
    if parent then
        local owner = parent:FindFirstChild("Owner")
        if owner and owner:IsA("StringValue") then return owner.Value end
        if parent.Parent and parent.Parent.Name == "Plots" then return parent.Name end
    end
    return "Desconocido"
end

