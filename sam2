local function getMyPlot()
    local plotsFolder = workspace:FindFirstChild("Plots")
    if not plotsFolder then return nil end
    local myName = LP.Name
    local myId = tostring(LP.UserId)

    for _, plot in ipairs(plotsFolder:GetChildren()) do
        local owner = plot:GetAttribute("Player") or plot:GetAttribute("Owner")
        if owner == myName then return plot end
        local ownerId = plot:GetAttribute("OwnerId") or plot:GetAttribute("PlayerId")
        if ownerId and tostring(ownerId) == myId then return plot end
    end

    for _, name in ipairs({"Plot","PlotObject","House","Base","MyPlot","CurrentPlot"}) do
        local v = LP:FindFirstChild(name)
        if v then
            if v:IsA("ObjectValue") and v.Value and v.Value:IsA("Model") then
                if v.Value:IsDescendantOf(plotsFolder) then return v.Value end
            elseif v:IsA("StringValue") then
                local p = plotsFolder:FindFirstChild(v.Value)
                if p then return p end
            end
        end
    end

    local char = LP.Character
    if char and char:FindFirstChild("HumanoidRootPart") then
        local hrp = char.HumanoidRootPart
        local closest, closestDist = nil, 60
        for _, plot in ipairs(plotsFolder:GetChildren()) do
            local pos = plot:GetPivot().Position
            local dist = (pos - hrp.Position).Magnitude
            if dist < closestDist then
                closestDist = dist
                closest = plot
            end
        end
        if closest then return closest end
    end

    return nil
end

local function findCaseMultiplierPos(myPlot)
    if not myPlot then return nil, nil end
    local patterns = {
        "case multiplier", "cash multiplier", "cash mult", "case mult",
        "multiplier", "multiplicador", "x2", "x3", "x4", "x5", "cash/s", "case/s"
    }

    local function resolvePosition(gui)
        local adornee = gui:IsA("BillboardGui") and gui.Adornee or nil
        if adornee and adornee:IsA("BasePart") then return adornee.Position, adornee end
        if adornee and adornee:IsA("Model") and adornee.PrimaryPart then
            return adornee.PrimaryPart.Position, adornee.PrimaryPart
        end
        if gui:IsA("SurfaceGui") then
            local parent = gui.Parent
            if parent and parent:IsA("BasePart") then return parent.Position, parent end
        end
        local p = gui.Parent
        local depth = 0
        while p and p ~= myPlot and depth < 8 do
            if p:IsA("BasePart") then return p.Position, p end
            if p:IsA("Model") and p.PrimaryPart then return p.PrimaryPart.Position, p.PrimaryPart end
            p = p.Parent
            depth = depth + 1
        end
        return nil, nil
    end

    for _, d in ipairs(myPlot:GetDescendants()) do
        if d:IsA("BillboardGui") or d:IsA("SurfaceGui") then
            local matched = nil
            for _, txt in ipairs(d:GetDescendants()) do
                if txt:IsA("TextLabel") or txt:IsA("TextButton") or txt:IsA("TextBox") then
                    local lower = tostring(txt.Text or ""):lower()
                    for _, pat in ipairs(patterns) do
                        if lower:find(pat, 1, true) then matched = txt.Text; break end
                    end
                    if matched then break end
                end
            end
            if matched then
                local pos, inst = resolvePosition(d)
                if pos then return pos, inst end
            end
        end
    end

    for _, d in ipairs(myPlot:GetDescendants()) do
        if d:IsA("BasePart") then
            local n = d.Name:lower()
            if n:find("multiplier") or n:find("case") or n:find("cash") then
                return d.Position, d
            end
        end
    end

    return nil, nil
end

local ROAD_KEYWORDS = { "road","path","street","walkway","sidewalk" }
local function findNearbyRoad(fromPos)
    local candidates = {}
    for _, obj in ipairs(workspace:GetChildren()) do
        if obj:IsA("BasePart") then
            for _, kw in ipairs(ROAD_KEYWORDS) do
                if obj.Name:lower():find(kw) and obj.Size.Magnitude>30 then
                    table.insert(candidates, obj); break
                end
            end
        end
    end
    local best, bd = nil, 500
    for _, p in ipairs(candidates) do
        local d = (p.Position-fromPos).Magnitude
        if d>5 and d<bd then bd=d; best=p end
    end
    return best
end

local function getPlotFloor(myPlot)
    local lowestY = math.huge
    local baseX, baseZ = myPlot:GetPivot().X, myPlot:GetPivot().Z
    for _, p in ipairs(myPlot:GetDescendants()) do
        if p:IsA("BasePart") and not p:IsDescendantOf(LP.Character) and p.Size.X>15 and p.Size.Z>15 then
            if p.Position.Y<lowestY then lowestY=p.Position.Y; baseX=p.Position.X; baseZ=p.Position.Z end
        end
    end
    if lowestY==math.huge then return myPlot:GetPivot().Position end
    return Vector3.new(baseX, lowestY+3, baseZ)
end

local function getPlotDoorPosition(myPlot)
    if not myPlot then return nil end
    for _, d in ipairs(myPlot:GetDescendants()) do
        if d:IsA("SpawnLocation") then return d.Position+Vector3.new(0,3,0) end
    end
    local doorKeywords = { "door","entrance","spawn","gate","exit","front" }
    for _, d in ipairs(myPlot:GetDescendants()) do
        if d:IsA("BasePart") then
            local n = d.Name:lower()
            for _, kw in ipairs(doorKeywords) do
                if n:find(kw) then
                    local sz = d.Size.Magnitude
                    if sz>0.5 and sz<50 then return d.Position+Vector3.new(0,3,0) end
                end
            end
        end
    end
    local plotPos = myPlot:GetPivot().Position
    local road = findNearbyRoad(plotPos)
    if road then
        local roadDir = road.Position - plotPos
        roadDir = Vector3.new(roadDir.X, 0, roadDir.Z)
        if roadDir.Magnitude > 1 then
            roadDir = roadDir.Unit
            local bestPart, bestProj = nil, -math.huge
            for _, d in ipairs(myPlot:GetDescendants()) do
                if d:IsA("BasePart") and d.Size.Y<8 and d.Size.Magnitude>2 then
                    local rel = d.Position - plotPos
                    local proj = Vector3.new(rel.X,0,rel.Z):Dot(roadDir)
                    if proj>bestProj then bestProj=proj; bestPart=d end
                end
            end
            if bestPart then return bestPart.Position + Vector3.new(0,3,0) end
        end
    end
    return getPlotFloor(myPlot)
end

local function getSafeGroundPosition(pos)
    if not pos then return nil end
    local rp = RaycastParams.new()
    rp.FilterType = Enum.RaycastFilterType.Exclude
    rp.FilterDescendantsInstances = { LP.Character }
    local rayStart = Vector3.new(pos.X, pos.Y + 20, pos.Z)
    local result = workspace:Raycast(rayStart, Vector3.new(0, -100, 0), rp)
    if result then return result.Position + Vector3.new(0, 4, 0) end
    return pos + Vector3.new(0, 5, 0)
end

