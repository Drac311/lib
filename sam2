                    task.wait(1); t = t + 1
                    if not S.autoServerHop then isHopping = false; break end
                end
                if S.autoServerHop and isHopping then HopServer() end
            end
        end

        if S.webhookEnabled and entry and not isHopping and not isStealing then
            if val >= S.minBrainrotValue then
