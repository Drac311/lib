local function waitPromptShown(targetPrompt, timeout)
    timeout = timeout or 0.8
    local t0 = tick()
    while tick() - t0 < timeout do
        if lastShownPrompt == targetPrompt then return true end
        task.wait(0.02)
    end
    return false
end

local function simulateE(prompt)
    if not prompt or not prompt.Parent then return nil, "no prompt" end
    if not prompt.Enabled then return nil, "disabled" end

    local holdDur = math.max((prompt.HoldDuration or 1.5), 1.5)
    local total = holdDur + S.holdMargin

    pcall(function()
        VIM:SendKeyEvent(true, Enum.KeyCode.E, false, game)
    end)
    task.wait(0.05)

    local okBegin = pcall(function() prompt:InputHoldBegin() end)
    if not okBegin then
        pcall(function() VIM:SendKeyEvent(false, Enum.KeyCode.E, false, game) end)
        return nil, "InputHoldBegin failed"
    end

    task.wait(total)

    pcall(function() prompt:InputHoldEnd() end)
    task.wait(0.05)

    pcall(function()
        VIM:SendKeyEvent(false, Enum.KeyCode.E, false, game)
    end)

    return "VIM+InputHold"
end

local function PerformStealSequence(autoGrab, loopMode)
    if isStealing then return nil end
    isStealing = true

    local oN, oR, oK = S.noclipActive, S.antiRagdoll, S.antiKnockback
    S.noclipActive = true; S.antiRagdoll = true; S.antiKnockback = true
    if _noclipToggle then _noclipToggle:Set(true, true) end
    if _ragdollToggle then _ragdollToggle:Set(true, true) end
    if _knockbackToggle then _knockbackToggle:Set(true, true) end

    local char = LP.Character
    local hrp = char and char:FindFirstChild("HumanoidRootPart")

    local function Cleanup()
        S.noclipActive=oN; S.antiRagdoll=oR; S.antiKnockback=oK
        if _noclipToggle then _noclipToggle:Set(oN, true) end
        if _ragdollToggle then _ragdollToggle:Set(oR, true) end
        if _knockbackToggle then _knockbackToggle:Set(oK, true) end
        if char and char:FindFirstChild("HumanoidRootPart") then
            char.HumanoidRootPart.Anchored = false
        end
        isStealing = false
        if not loopMode then
            S.autoSteal = false
            if S.stealMode=="v1" and _autoStealToggle then _autoStealToggle:Set(false,true) end
            if S.stealMode=="v2" and _autoStealV2Toggle then _autoStealV2Toggle:Set(false,true) end
            S.stealMode = nil
        end
    end

    if not hrp then return Cleanup() end

    -- ★ Detectar home (Case Multiplier prioritario)
    local homePos = getHomePosition()
    if homePos then
        S.myBasePos = homePos
        print(string.format("[Draxi] 🏠 Home: %.0f, %.0f, %.0f", homePos.X, homePos.Y, homePos.Z))
    else
        homePos = hrp.Position
        S.myBasePos = homePos
        print("[Draxi] ⚠ Home no detectado, usando pos actual")
    end

    local entry = findBestBrainrot(S.rankingMode or "value")
    if not entry then
        Window:Notify({ Title="Auto Steal", Content="Sin brainrot", Duration=2 })
        return Cleanup()
    end

    if not S.autoSteal then return Cleanup() end

    hrp.Anchored = true
    hrp.AssemblyLinearVelocity = Vector3.zero
    hrp.CFrame = CFrame.new(entry.pos + Vector3.new(0, 4, 0))
    task.wait(0.15)
    hrp.Anchored = false
    task.wait(S.settleAfterTP)
    if not S.autoSteal then return Cleanup() end

    if autoGrab then
        waitPromptShown(entry.prompt, 0.8)
        local prevS = stats.success
        local method, reason = simulateE(entry.prompt)
        task.wait(S.waitAfterFire)
        if stats.success > prevS then
            print(string.format("[Draxi] ✓ %s", entry.name))
        else
            print(string.format("[Draxi] ✗ %s | Fail: %s", entry.name, tostring(stats.lastMsg)))
        end
    else
        Window:Notify({ Title="Auto Steal", Content="Coge y pulsa [PASO 2]", Duration=10 })
        local clicked = false
        local conn
        conn = confirmGrabEvent.Event:Connect(function() clicked = true end)
        local timeout = 30
        while not clicked and timeout > 0 do
            if not S.autoSteal then conn:Disconnect(); return Cleanup() end
            task.wait(0.1); timeout = timeout - 0.1
        end
        conn:Disconnect()
        if not clicked then return Cleanup() end
    end

    if not S.autoSteal then return Cleanup() end

    -- ★ Volver a Case Multiplier
    hrp.AssemblyLinearVelocity = Vector3.zero
    hrp.Anchored = true
    hrp.CFrame = CFrame.new(homePos)
    task.wait(0.25)
    hrp.Anchored = false

    Cleanup()
end

