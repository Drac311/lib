local function getMutationMultiplier(model)
    local m = model:GetAttribute("Mutation") or ""
    local mult = 1
    if m=="Gold" or m=="Golden" then mult=1.5
    elseif m=="Diamond" then mult=2
    elseif m=="Rainbow" then mult=3
    elseif m=="Candy" then mult=4 end
    return mult
end

local function getBrainrotValue(model)
    if not model then return 0 end
    local v = 0
    if AnimalData[model.Name] then
        v = AnimalData[model.Name].Price or AnimalData[model.Name].Value or 0
    end
    if v==0 then v = model:GetAttribute("Price") or model:GetAttribute("Value") or 0 end
    return v * getMutationMultiplier(model)
end

local function getBrainrotIncome(model)
    if not model then return 0 end
    local v = 0
    if AnimalData[model.Name] then
        v = AnimalData[model.Name].Income or AnimalData[model.Name].Money or 0
    end
    if v==0 then v = model:GetAttribute("Income") or model:GetAttribute("Money") or 0 end
    return v * getMutationMultiplier(model)
end

local function isInFusion(model)
