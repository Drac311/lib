local function HopServer()
    MainWindow:Notify({ Title="Hop", Content="Buscando...", Duration=3 })
    local ok, res = pcall(game.HttpGet, game, "https://games.roblox.com/v1/games/"..game.PlaceId.."/servers/Public?sortOrder=Asc&limit=100")
    if not ok then isHopping=false; return end
    local ok2, decoded = pcall(HttpService.JSONDecode, HttpService, res)
    if not ok2 or not decoded.data then isHopping=false; return end
    local avail = {}
    for _, srv in ipairs(decoded.data) do
        if srv.playing < srv.maxPlayers and srv.id ~= game.JobId then
            table.insert(avail, srv.id)
        end
    end
    if #avail > 0 then
        pcall(function() TS:TeleportToPlaceInstance(game.PlaceId, avail[math.random(1,#avail)], LP) end)
    else
        isHopping = false
        MainWindow:Notify({ Title="Hop", Content="Sin servers", Duration=3 })
    end
end

local lastShownPrompt, lastShownTick = nil, 0
PPS.PromptShown:Connect(function(prompt)
    lastShownPrompt = prompt
    lastShownTick = tick()
end)
PPS.PromptHidden:Connect(function(prompt)
    if lastShownPrompt == prompt then lastShownPrompt = nil end
end)

local function waitPromptStable(targetPrompt, timeout)
    timeout = tonumber(timeout) or 3
    local t0 = tick()
    while tick() - t0 < timeout do
        if lastShownPrompt == targetPrompt and (tick() - lastShownTick) > 0.3 then
            return true
        end
        task.wait(0.05)
    end
    return lastShownPrompt == targetPrompt
end

local function simulateE(prompt)
    if not prompt or not prompt.Parent then return nil, "no prompt" end
    if not prompt.Enabled then return nil, "disabled" end

    local holdDur = math.max((tonumber(prompt.HoldDuration) or 1.5), 1.5)
    local total = holdDur + S.holdMargin

    pcall(function()
        VIM:SendKeyEvent(true, Enum.KeyCode.E, false, game)
    end)
    task.wait(0.05)

    local okBegin = pcall(function() prompt:InputHoldBegin() end)
    if not okBegin then
        pcall(function() VIM:SendKeyEvent(false, Enum.KeyCode.E, false, game) end)
        return nil, "InputHoldBegin failed"
    end

    task.wait(total)

    pcall(function() prompt:InputHoldEnd() end)
    task.wait(0.05)

    pcall(function()
        VIM:SendKeyEvent(false, Enum.KeyCode.E, false, game)
    end)

    return "VIM+InputHold"
end

local function PerformStealSequence(loopMode, minThreshold)
    if isStealing or S.kicking then return nil end
    isStealing = true

    local oN, oR, oK = S.noclipActive, S.antiRagdoll, S.antiKnockback
    S.noclipActive = true; S.antiRagdoll = true; S.antiKnockback = true
    if _noclipToggle then _noclipToggle:Set(true, true) end
    if _ragdollToggle then _ragdollToggle:Set(true, true) end
    if _knockbackToggle then _knockbackToggle:Set(true, true) end

    local char = LP.Character
    local hrp = char and char:FindFirstChild("HumanoidRootPart")

    local function Cleanup()
        S.noclipActive=oN; S.antiRagdoll=oR; S.antiKnockback=oK
        if _noclipToggle then _noclipToggle:Set(oN, true) end
        if _ragdollToggle then _ragdollToggle:Set(oR, true) end
        if _knockbackToggle then _knockbackToggle:Set(oK, true) end
        if char and char:FindFirstChild("HumanoidRootPart") then
            char.HumanoidRootPart.Anchored = false
        end
        isStealing = false
        if not loopMode then
            S.autoSteal = false
            if S.stealMode=="any" and _autoStealAnyToggle then _autoStealAnyToggle:Set(false,true) end
            if S.stealMode=="min" and _autoStealMinToggle then _autoStealMinToggle:Set(false,true) end
            S.stealMode = nil
        end
    end

    if not hrp then Cleanup() return nil end

    local homePos = getHomePosition()
    if homePos then
        S.myBasePos = homePos
    else
        homePos = hrp.Position
        S.myBasePos = homePos
    end

    local entry = findBestBrainrot(S.rankingMode or "value", minThreshold)
    if not entry then
        if minThreshold then
            MainWindow:Notify({ Title="Auto Steal", Content="Ningún brainrot >= min", Duration=2 })
        else
            MainWindow:Notify({ Title="Auto Steal", Content="Sin brainrot", Duration=2 })
        end
        Cleanup() return nil
    end

    if not S.autoSteal then Cleanup() return nil end

    local entryHopScore = getHopScore(entry.model)

    -- 1. Teletransporte
    hrp.Anchored = true
    hrp.AssemblyLinearVelocity = Vector3.zero
    hrp.CFrame = CFrame.new(entry.pos + Vector3.new(0, 4, 0))
    task.wait(0.15)
    hrp.Anchored = false

    -- ★ 2. Movimiento pequeño en círculos (3 studs) para que aparezca el Prompt
    local hum = char:FindFirstChildOfClass("Humanoid")
    if hum then
        local randomDir = Vector3.new(math.random(-10, 10), 0, math.random(-10, 10)).Unit
        if randomDir.Magnitude == 0 then randomDir = Vector3.new(1, 0, 0) end
        hum:MoveTo(hrp.Position + (randomDir * 3))
        task.wait(0.3)
        hum:MoveTo(hrp.Position) -- Detenerse
        hrp.AssemblyLinearVelocity = Vector3.zero
    end

    -- 3. Cámara mirando al Brainrot
    local cam = workspace.CurrentCamera
    if cam then
        local targetPos = entry.pos + Vector3.new(0, 2, 0)
        local playerPos = hrp.Position + Vector3.new(0, 2, 0)
        local dir = (targetPos - playerPos).Unit
        local camPos = playerPos - (dir * 6) + Vector3.new(0, 3, 0)
        cam.CFrame = CFrame.lookAt(camPos, targetPos)
    end

    task.wait(S.settleAfterTP)
    if not S.autoSteal then Cleanup() return nil end

    waitPromptStable(entry.prompt, 3)
    task.wait(0.2)

    -- 4. Intentar robar
    local prevS = stats.success
    local wasInPlot = entry.model and entry.model:IsDescendantOf(entry.plot)
    
    local method, _reason = simulateE(entry.prompt)
    task.wait(S.waitAfterFire)

    -- ★ 5. Comprobación de robo (por evento Success O por desaparición del modelo/prompt)
    local stolenByModel = false
    if not entry.model or not entry.model.Parent then
        stolenByModel = true
    elseif not entry.model:IsDescendantOf(entry.plot) then
        stolenByModel = true
    end
    
    local promptGone = not entry.prompt or not entry.prompt.Parent or not entry.prompt.Enabled

    if stats.success > prevS or stolenByModel or (promptGone and wasInPlot) then
        print(string.format("[Draxi] ✓ %s", entry.name))
        if S.autoKick and not S.kicking and entryHopScore >= S.minBrainrotValue then
            MainWindow:Notify({
                Title="👢 Auto Kick",
                Content=string.format("%s (%s) >= Min. Kick en 1.5s...",
                    entry.name, formatNumber(entryHopScore)),
                Duration=2,
            })
            task.delay(1.5, function()
                if not S.kicking then
                    kickSelf(string.format("Draxi: %s (%s)", entry.name, formatNumber(entryHopScore)))
                end
            end)
        end
    else
        print(string.format("[Draxi] ✗ %s | Fail: %s", entry.name, tostring(stats.lastMsg)))
    end

    if S.kicking or not S.autoSteal then Cleanup() return nil end

    -- 6. Volver a base
    hrp.AssemblyLinearVelocity = Vector3.zero
    hrp.Anchored = true
    hrp.CFrame = CFrame.new(homePos)
    task.wait(0.25)
    hrp.Anchored = false

    Cleanup()
    return nil
end

