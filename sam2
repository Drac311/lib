local function getMutationMultiplier(model)
    local m = model:GetAttribute("Mutation") or ""
    local mult = 1
    if m=="Gold" or m=="Golden" then mult=1.5
    elseif m=="Diamond" then mult=2
    elseif m=="Rainbow" then mult=3
    elseif m=="Candy" then mult=4 end
    return mult
end

local INCOME_KEYS = {
    "income","money","earn","persec","persecond","per_sec","rate",
    "cps","mps","generation","gen","produce","profit","yield",
    "cashflow","cash","dollars"
}
local VALUE_KEYS = { "price","value","cost","worth","rarity" }

local function nameMatches(name, keys)
    local lower = tostring(name):lower()
    for _, k in ipairs(keys) do
        if lower:find(k, 1, true) then return true end
    end
    return false
end

local SUFFIX = { K=1e3, M=1e6, B=1e9, T=1e12, Q=1e15 }
local function parseNumberFromText(text)
    if not text or text == "" then return 0 end
    local clean = tostring(text):gsub(",", ""):gsub("%s", "")
    local numStr = clean:match("(%d+%.?%d*)")
    if not numStr then return 0 end
    local suffix = clean:match("%d+%.?%d*([KMBTQ])")
    local num = tonumber(numStr) or 0
    if suffix then
        suffix = suffix:upper()
        if SUFFIX[suffix] then num = num * SUFFIX[suffix] end
    end
    return num
end

local function findAnimalEntry(model)
    if not model then return nil end
    local entry = AnimalData[model.Name]
    if type(entry) == "table" then return entry end
    local baseName = model.Name:gsub("%s*[%(%[].*$", ""):gsub("%s+$", "")
    if baseName ~= model.Name then
        entry = AnimalData[baseName]
        if type(entry) == "table" then return entry end
    end
    local lower = baseName:lower()
    for name, data in pairs(AnimalData) do
        local ln = tostring(name):lower()
        if ln == lower or lower:find(ln, 1, true) or ln:find(lower, 1, true) then
            if type(data) == "table" then return data end
        end
    end
    return nil
end

local function searchAnimalData(model, keys)
    local entry = findAnimalEntry(model)
    if not entry then return 0 end
    for _, k in ipairs(keys) do
        if type(entry[k]) == "number" then return entry[k] end
    end
    for fieldName, fieldVal in pairs(entry) do
        if type(fieldVal) == "number" and nameMatches(fieldName, keys) then
            return fieldVal
        end
    end
    return 0
end

local function searchAttributes(inst, keys)
    for attrName, attrVal in pairs(inst:GetAttributes()) do
        if type(attrVal) == "number" and nameMatches(attrName, keys) then
            return attrVal
        end
    end
    return 0
end

local function searchDescendants(model, keys)
    for _, d in ipairs(model:GetDescendants()) do
        if (d:IsA("NumberValue") or d:IsA("IntValue")) and nameMatches(d.Name, keys) then
            return d.Value
        end
    end
    return 0
end

local function extractIncomeFromText(text)
    if not text or text == "" then return 0 end
    local numStr, suffix = text:match("([%d%.%,]+)([KMBTQ]?)/s")
    if not numStr then
        numStr, suffix = text:match("([%d%.%,]+)([KMBTQ]?)%s*/%s*[sS]")
    end
    if not numStr then return 0 end
    numStr = numStr:gsub(",", "")
    local num = tonumber(numStr) or 0
    if suffix and suffix ~= "" then
        local s = suffix:upper()
        if SUFFIX[s] then num = num * SUFFIX[s] end
    end
    return num
end

local function searchGuiText(model, keys, isIncome)
    for _, d in ipairs(model:GetDescendants()) do
        if d:IsA("TextLabel") and d.Text and d.Text ~= "" then
            if isIncome then
                local n = extractIncomeFromText(d.Text)
                if n > 0 then return n end
            else
                local n = parseNumberFromText(d.Text)
                if n > 0 then return n end
            end
        end
    end
    return 0
end

local function getBrainrotIncome(model)
    if not model then return 0 end
    local mult = getMutationMultiplier(model)
    local entry = findAnimalEntry(model)
    if entry and type(entry.Generation) == "number" then
        return entry.Generation * mult
    end
    local v = searchAnimalData(model, INCOME_KEYS)
    if v > 0 then return v * mult end
    v = searchAttributes(model, INCOME_KEYS);   if v>0 then return v*mult end
    v = searchDescendants(model, INCOME_KEYS);  if v>0 then return v*mult end
    v = searchGuiText(model, INCOME_KEYS, true)
    if v > 0 then return v * mult end
    return 0
end

local function getBrainrotValue(model)
    if not model then return 0 end
    local mult = getMutationMultiplier(model)
    local entry = findAnimalEntry(model)
    if entry and type(entry.Price) == "number" then
        return entry.Price * mult
    end
    local v = searchAnimalData(model, VALUE_KEYS)
    if v > 0 then return v * mult end
    v = searchAttributes(model, VALUE_KEYS);    if v>0 then return v*mult end
    v = searchDescendants(model, VALUE_KEYS);   if v>0 then return v*mult end
    v = searchGuiText(model, VALUE_KEYS, false)
    if v > 0 then return v * mult end
    return 0
end

