local function HopServer()
    Window:Notify({ Title="Hop", Content="Buscando...", Duration=3 })
    local ok, res = pcall(game.HttpGet, game, "https://games.roblox.com/v1/games/"..game.PlaceId.."/servers/Public?sortOrder=Asc&limit=100")
    if not ok then isHopping=false; return end
    local ok2, decoded = pcall(HttpService.JSONDecode, HttpService, res)
    if not ok2 or not decoded.data then isHopping=false; return end
    local avail = {}
    for _, srv in ipairs(decoded.data) do
        if srv.playing < srv.maxPlayers and srv.id ~= game.JobId then
            table.insert(avail, srv.id)
        end
    end
    if #avail > 0 then
        pcall(function() TS:TeleportToPlaceInstance(game.PlaceId, avail[math.random(1,#avail)], LP) end)
    else
        isHopping = false
        Window:Notify({ Title="Hop", Content="Sin servers", Duration=3 })
    end
end

-- ── Vuelo ──────────────────────────────────────────────────
local function FlyTo(targetPos, speed, cancelCheck)
    local char = LP.Character
    if not char or not char:FindFirstChild("HumanoidRootPart") then return end
    local hrp = char.HumanoidRootPart
    local startPos = hrp.Position
    local dist = (targetPos-startPos).Magnitude
    local duration = math.clamp(dist/speed, 0.5, 4)
    local t0 = tick()
    local conn
    conn = RunSvc.RenderStepped:Connect(function()
        if cancelCheck and not cancelCheck() then conn:Disconnect(); return end
        if not char.Parent or not hrp.Parent then conn:Disconnect(); return end
        local t = math.clamp((tick()-t0)/duration, 0, 1)
        char:PivotTo(CFrame.new(startPos:Lerp(targetPos, t)))
        if t>=1 then conn:Disconnect() end
    end)
    while conn.Connected do task.wait() end
end

-- ── Simulación de tecla E ──────────────────────────────────
local function facePrompt(prompt)
    local cam = workspace.CurrentCamera
    local char = LP.Character
    if not cam or not char then return end
    local hrp = char:FindFirstChild("HumanoidRootPart")
    if not hrp then return end
    local targetPart = prompt.Parent and prompt.Parent.Parent
    if targetPart and targetPart:IsA("BasePart") then
        cam.CFrame = CFrame.lookAt(hrp.Position + Vector3.new(0, 2, 0), targetPart.Position)
    end
end

local function simulateE(prompt)
    local hold = (prompt.HoldDuration or 1.5) + 0.3

    -- Método VIM (funciona en background)
    local vim = game:GetService("VirtualInputManager")
    if vim and vim.SendKeyEvent then
        local ok = pcall(function()
            vim:SendKeyEvent(true, Enum.KeyCode.E, false, game)
            task.wait(hold)
            vim:SendKeyEvent(false, Enum.KeyCode.E, false, game)
        end)
        if ok then return "VIM" end
    end

    -- Fallback: InputHold
    local ok2 = pcall(function()
        prompt:InputHoldBegin()
        task.wait(hold)
        prompt:InputHoldEnd()
    end)
    if ok2 then return "InputHold" end

    -- Fallback: keypress (requiere focus)
    if keypress and keyrelease then
        local ok3 = pcall(function()
            keypress("E")
            task.wait(hold)
            keyrelease("E")
        end)
        if ok3 then return "keypress" end
    end

    return nil
end

-- ── Secuencia de robo ──────────────────────────────────────
local function PerformStealSequence(autoGrab, loopMode)
    if isStealing then return nil end
    isStealing = true

    local oN, oR, oK = S.noclipActive, S.antiRagdoll, S.antiKnockback
    S.noclipActive = true; S.antiRagdoll = true; S.antiKnockback = true
    if _noclipToggle then _noclipToggle:Set(true, true) end
    if _ragdollToggle then _ragdollToggle:Set(true, true) end
    if _knockbackToggle then _knockbackToggle:Set(true, true) end

    local char = LP.Character
    local hrp = char and char:FindFirstChild("HumanoidRootPart")

    local function Cleanup()
        S.noclipActive=oN; S.antiRagdoll=oR; S.antiKnockback=oK
        if _noclipToggle then _noclipToggle:Set(oN, true) end
        if _ragdollToggle then _ragdollToggle:Set(oR, true) end
        if _knockbackToggle then _knockbackToggle:Set(oK, true) end
        if char and char:FindFirstChild("HumanoidRootPart") then
            char.HumanoidRootPart.Anchored = false
        end
        isStealing = false
        if not loopMode then
            S.autoSteal = false
            if S.stealMode=="v1" and _autoStealToggle then _autoStealToggle:Set(false,true) end
            if S.stealMode=="v2" and _autoStealV2Toggle then _autoStealV2Toggle:Set(false,true) end
            S.stealMode = nil
        end
    end

    if not hrp then return Cleanup() end
    local baseCFrame = hrp.CFrame
    S.myBasePos = baseCFrame.Position

    local entry = findBestBrainrot(S.rankingMode or "value")
    if not entry then
        Window:Notify({ Title="Auto Steal", Content="Sin brainrot", Duration=2 })
        return Cleanup()
    end

    Window:Notify({ Title="Auto Steal",
        Content="→ "..entry.name.." ("..entry.owner..")", Duration=2 })

    if not S.autoSteal then return Cleanup() end

    hrp.Anchored = true
    hrp.AssemblyLinearVelocity = Vector3.zero
    hrp.CFrame = CFrame.new(entry.pos + Vector3.new(0, 3, 0))
    print(string.format("[Draxi] TP → %s | settle=%.1fs", entry.name, S.settleAfterTP))
    task.wait(S.settleAfterTP)
    if not S.autoSteal then return Cleanup() end

    if autoGrab then
        facePrompt(entry.prompt)
        task.wait(0.3)

        local prevS = stats.success
        local method = simulateE(entry.prompt)
        print("[Draxi] Método E: "..tostring(method))
        task.wait(S.waitAfterFire)

        if stats.success > prevS then
            print("[Draxi] ✓ SUCCESS confirmado")
            getgenv().__DraxiWorkingMethod = method
        else
            print("[Draxi] ⚠ Sin SUCCESS. Último FAILURE: "..tostring(stats.lastMsg))
        end
    else
        hrp.Anchored = false
        Window:Notify({ Title="Auto Steal", Content="Coge y pulsa [PASO 2]", Duration=10 })
        local clicked = false
        local conn
        conn = confirmGrabEvent.Event:Connect(function() clicked = true end)
        local timeout = 30
        while not clicked and timeout > 0 do
            if not S.autoSteal then conn:Disconnect(); return Cleanup() end
            task.wait(0.1); timeout = timeout - 0.1
        end
        conn:Disconnect()
        if not clicked then return Cleanup() end
        hrp.Anchored = true
    end

    if not S.autoSteal then return Cleanup() end

    hrp.AssemblyLinearVelocity = Vector3.zero
    hrp.CFrame = baseCFrame
    task.wait(0.5)

    hrp.Anchored = false
    Cleanup()
end

