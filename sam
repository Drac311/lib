        if srv.playing < srv.maxPlayers and srv.id ~= game.JobId then
            table.insert(availableServers, srv.id)
        end
    end
    
    if #availableServers > 0 then
        local chosenServer = availableServers[math.random(1, #availableServers)]
        pcall(function()
            TS:TeleportToPlaceInstance(game.PlaceId, chosenServer, LP)
        end)
    else
        Window:Notify({ Title = "Server Hop", Content = "No se encontraron servidores disponibles.", Duration = 3 })
        isHopping = false
    end
end

-- ── Auto Steal ───────────────────────────────────────────────
local function FlyTo(targetPos, speed, cancelCheck)
    local char = LP.Character
    if not char or not char:FindFirstChild("HumanoidRootPart") then return end
    local hrp = char.HumanoidRootPart
    local startPos = hrp.Position
    local dist = (targetPos - startPos).Magnitude
    local duration = math.clamp(dist / speed, 0.5, 4)
    local startTime = tick()

    local conn
    conn = RunSvc.RenderStepped:Connect(function()
        if cancelCheck and not cancelCheck() then
            conn:Disconnect()
            return
        end
        if not char.Parent or not hrp.Parent then 
            if conn then conn:Disconnect() end
            return 
        end
        local elapsed = tick() - startTime
        local t = math.clamp(elapsed / duration, 0, 1)
        char:PivotTo(CFrame.new(startPos:Lerp(targetPos, t)))
        if t >= 1 then
            conn:Disconnect()
        end
    end)
    while conn.Connected do task.wait() end
end

local function PerformStealSequence()
    if isStealing then return nil end
    isStealing = true

    local originalNoclip = S.noclipActive
    local originalRagdoll = S.antiRagdoll
    local originalKnockback = S.antiKnockback

    S.noclipActive = true
    S.antiRagdoll = true
    S.antiKnockback = true

    if _noclipToggle then _noclipToggle:Set(true) end
    if _ragdollToggle then _ragdollToggle:Set(true) end
    if _knockbackToggle then _knockbackToggle:Set(true) end

    local char = LP.Character
    local hum = char and char:FindFirstChildOfClass("Humanoid")
    
    local cleanedUp = false
    local function Cleanup(aborted)
        if cleanedUp then return end
        cleanedUp = true

        S.noclipActive = originalNoclip
        S.antiRagdoll = originalRagdoll
        S.antiKnockback = originalKnockback

        if _noclipToggle then _noclipToggle:Set(originalNoclip) end
        if _ragdollToggle then _ragdollToggle:Set(originalRagdoll) end
        if _knockbackToggle then _knockbackToggle:Set(originalKnockback) end

        if char and char:FindFirstChild("HumanoidRootPart") then
            char.HumanoidRootPart.Anchored = false
        end

        isStealing = false
        
        if aborted then
            if hum then hum.Health = 0 end
        end
        
        if _autoStealToggle then _autoStealToggle:Set(false) end
    end

    Window:Notify({ Title = "Auto Steal", Content = "Noclip, Defensas y UI ON.", Duration = 3 })

    if not S.autoSteal then return Cleanup(true) end

    local bestModel = findBestBrainrot()
    if not bestModel then 
        Window:Notify({ Title = "Auto Steal", Content = "No se encontró ningún Brainrot (o el mejor es tuyo).", Duration = 3 })
        return Cleanup(false)
    end

    local primary = bestModel.PrimaryPart or bestModel:FindFirstChildWhichIsA("BasePart")
    if not primary or not char or not hum then return Cleanup(false) end

    Window:Notify({ Title = "Auto Steal", Content = "Volando bajo el mapa al Brainrot...", Duration = 3 })
    
    local hrp = char.HumanoidRootPart
    hrp.Anchored = true

    local currentPos = hrp.Position
    
    local groundY = getGroundY(primary.Position.X, primary.Position.Z)
    local undergroundY = math.min(currentPos.Y - 10, groundY - 5)
    
    local underStartPos = Vector3.new(currentPos.X, undergroundY, currentPos.Z)
    -- 🚨 BAJAR 5 STUDS EXTRA AL VIAJAR
    local underTargetPos = Vector3.new(primary.Position.X, undergroundY - 5, primary.Position.Z)
    local targetSurfacePos = primary.Position + Vector3.new(0, 3, 0)

    FlyTo(underStartPos, 30, function() return S.autoSteal end)
    if not S.autoSteal then return Cleanup(true) end

    FlyTo(underTargetPos, 60, function() return S.autoSteal end)
    if not S.autoSteal then return Cleanup(true) end

    FlyTo(targetSurfacePos, 30, function() return S.autoSteal end)

    hrp.Anchored = false

    if not S.autoSteal then return Cleanup(true) end

    Window:Notify({ Title = "Auto Steal", Content = "¡Coge el Brainrot y pulsa el botón verde en el menú!", Duration = 10 })
    
    local clickedConfirm = false
    local confirmConn
    confirmConn = confirmGrabEvent.Event:Connect(function()
        clickedConfirm = true
    end)

    local timeout = 30
    while not clickedConfirm and timeout > 0 do
        if not S.autoSteal then
            if confirmConn then confirmConn:Disconnect() end
            return Cleanup(true)
        end
        task.wait(0.1)
        timeout = timeout - 0.1
    end
    if confirmConn then confirmConn:Disconnect() end

    if not clickedConfirm then
        Window:Notify({ Title = "Auto Steal", Content = "Tiempo de espera agotado.", Duration = 3 })
        return Cleanup(false)
    end

    if not S.autoSteal then return Cleanup(true) end

    Window:Notify({ Title = "Auto Steal", Content = "¡Confirmado! Iniciando vuelo a tu base...", Duration = 3 })

    if bestModel and bestModel.Parent then
        for _, p in ipairs(bestModel:GetDescendants()) do
            if p:IsA("BasePart") then p.CanCollide = false end
        end
    end

    local hrp = char.HumanoidRootPart
    hrp.Anchored = true

    local currentPos = hrp.Position

    local myPlot = getMyPlot()
    local targetFloorPos = nil
    
    if myPlot then
        targetFloorPos = getPlotFloor(myPlot)
    elseif S.myBasePos then
        targetFloorPos = S.myBasePos
    end

    if targetFloorPos then
        local returnGroundY = getGroundY(targetFloorPos.X, targetFloorPos.Z)
        local returnUndergroundY = math.min(currentPos.Y - 10, returnGroundY - 5)
        
        local underReturnStartPos = Vector3.new(currentPos.X, returnUndergroundY, currentPos.Z)
        -- 🚨 BAJAR 5 STUDS EXTRA AL VIAJAR DE VUELTA
        local underReturnTargetPos = Vector3.new(targetFloorPos.X, returnUndergroundY - 5, targetFloorPos.Z)
        local safeSurfacePos = targetFloorPos + Vector3.new(0, 3, 0)

        FlyTo(underReturnStartPos, 30, function() return S.autoSteal end)
        if not S.autoSteal then return Cleanup(true) end

        FlyTo(underReturnTargetPos, 60, function() return S.autoSteal end)
        if not S.autoSteal then return Cleanup(true) end

        FlyTo(safeSurfacePos, 30, function() return S.autoSteal end)
    end

    hrp.Anchored = false

    if not S.autoSteal then return Cleanup(true) end

    Window:Notify({ Title = "Auto Steal", Content = "¡Llegaste a tu base!", Duration = 3 })

    if targetFloorPos then
        local rayOrigin = targetFloorPos + Vector3.new(0, 10, 0)
        local rayDir = Vector3.new(0, -50, 0)
        local rayParams = RaycastParams.new()
        rayParams.FilterDescendantsInstances = {char}
        rayParams.FilterType = Enum.RaycastFilterType.Exclude
        local result = workspace:Raycast(rayOrigin, rayDir, rayParams)
        if result then
            char:PivotTo(CFrame.new(result.Position + Vector3.new(0, 3, 0)))
        end
    end

    if bestModel and bestModel.Parent then
        for _, p in ipairs(bestModel:GetDescendants()) do
            if p:IsA("BasePart") then p.CanCollide = true end
        end
    end

    Cleanup(false)
    return nil
end

