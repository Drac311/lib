-- ── Mutación ────────────────────────────────────────────────
local function getMutationMultiplier(model)
    local mutation = model:GetAttribute("Mutation") or ""
    local mult = 1
    if mutation == "Gold" or mutation == "Golden" then mult = 1.5
    elseif mutation == "Diamond" then mult = 2
    elseif mutation == "Rainbow" then mult = 3
    elseif mutation == "Candy" then mult = 4 end
    for _, child in ipairs(model:GetChildren()) do
        if child.Name:lower():find("mutation") and child:IsA("StringValue") then
            local m = child.Value
            if m == "Gold" or m == "Golden" then mult = 1.5
            elseif m == "Diamond" then mult = 2
            elseif m == "Rainbow" then mult = 3
            elseif m == "Candy" then mult = 4 end
        end
    end
    return mult
end

local function getBrainrotValue(model)
    if not model then return 0 end
    local baseName = model.Name
    local value = 0
    if AnimalData[baseName] and type(AnimalData[baseName]) == "table" then
        value = AnimalData[baseName].Price or AnimalData[baseName].Cost or AnimalData[baseName].Value or 0
    end
    if value == 0 then
        value = model:GetAttribute("Price") or model:GetAttribute("Value") or model:GetAttribute("Income") or 0
    end
    if value == 0 then
        for _, v in ipairs(model:GetDescendants()) do
            if v:IsA("NumberValue") or v:IsA("IntValue") then
                if v.Name == "Price" or v.Name == "Value" or v.Name == "Income" then
                    value = v.Value; break
                end
            end
        end
    end
    return value * getMutationMultiplier(model)
end

local function getBrainrotIncome(model)
    if not model then return 0 end
    local baseName = model.Name
    local income = 0
    if AnimalData[baseName] and type(AnimalData[baseName]) == "table" then
        income = AnimalData[baseName].Income or AnimalData[baseName].Money or AnimalData[baseName].Earnings or AnimalData[baseName].IncomePerSecond or 0
    end
    if income == 0 then
        income = model:GetAttribute("Income") or model:GetAttribute("Money") or 0
    end
    if income == 0 then
        for _, v in ipairs(model:GetDescendants()) do
            if v:IsA("NumberValue") or v:IsA("IntValue") then
                local vName = v.Name:lower()
                if vName:find("income") or vName:find("money") or vName:find("earn") or vName:find("persec") or vName:find("rate") then
                    income = v.Value; break
                end
            end
        end
    end
    return income * getMutationMultiplier(model)
end

local function isInFusion(model)
    if not model or not model.Parent then return true end
    if model:GetAttribute("InFusion") or model:GetAttribute("Fusing") then return true end
    return false
end

local function getMyPlot()
    local plotsFolder = workspace:FindFirstChild("Plots")
    if not plotsFolder then return nil end
    local plotId = LP:GetAttribute("PlotId") or LP:GetAttribute("Plot") or LP:GetAttribute("PlotName") or LP:GetAttribute("OwnedPlot")
    if plotId then
        local p = plotsFolder:FindFirstChild(tostring(plotId))
        if p then return p end
        for _, plot in ipairs(plotsFolder:GetChildren()) do
            if plot:GetAttribute("PlotId") == plotId or plot:GetAttribute("Id") == plotId or plot:GetAttribute("Owner") == plotId then return plot end
        end
    end
    local plotValue = LP:FindFirstChild("Plot") or LP:FindFirstChild("PlotObject") or LP:FindFirstChild("House") or LP:FindFirstChild("Base")
    if plotValue then
        if plotValue:IsA("ObjectValue") and plotValue.Value then return plotValue.Value
        elseif plotValue:IsA("StringValue") then
            local p = plotsFolder:FindFirstChild(plotValue.Value)
            if p then return p end
        end
    end
    for _, plot in ipairs(plotsFolder:GetChildren()) do
        if plot:GetAttribute("Owner") == LP.Name or plot:GetAttribute("OwnerId") == LP.UserId
            or plot:GetAttribute("Player") == LP.Name or plot:GetAttribute("PlayerId") == LP.UserId then return plot end
        for _, child in ipairs(plot:GetDescendants()) do
            if child:IsA("StringValue") and (child.Value == LP.Name or child.Value == tostring(LP.UserId)) then return plot
            elseif child:IsA("NumberValue") and child.Value == LP.UserId then return plot
            elseif child:IsA("ObjectValue") and child.Value == LP then return plot end
        end
        if plot.Name:lower():find(LP.Name:lower()) or plot.Name == tostring(LP.UserId) then return plot end
    end
    local char = LP.Character
    if char and char:FindFirstChild("HumanoidRootPart") then
        local hrpPos = char.HumanoidRootPart.Position
        local closestPlot, shortestDist = nil, math.huge
        for _, plot in ipairs(plotsFolder:GetChildren()) do
            local pos = plot:GetPivot().Position
            if plot.PrimaryPart then pos = plot.PrimaryPart.Position end
            local dist = (pos - hrpPos).Magnitude
            if dist < 100 and dist < shortestDist then shortestDist = dist; closestPlot = plot end
        end
        if closestPlot then return closestPlot end
    end
    if S.myBasePos then
        local closestPlot, shortestDist = nil, math.huge
        for _, plot in ipairs(plotsFolder:GetChildren()) do
            local pos = plot:GetPivot().Position
            if plot.PrimaryPart then pos = plot.PrimaryPart.Position end
            local dist = (pos - S.myBasePos).Magnitude
            if dist < shortestDist and dist < 150 then shortestDist = dist; closestPlot = plot end
        end
        if closestPlot then return closestPlot end
    end
    return nil
end

local function getPlotFloor(myPlot)
    local lowestY = math.huge
    local baseX, baseZ = myPlot:GetPivot().X, myPlot:GetPivot().Z
    for _, part in ipairs(myPlot:GetDescendants()) do
        if part:IsA("BasePart") and not part:IsDescendantOf(LP.Character) then
            if part.Size.X > 15 and part.Size.Z > 15 then
                if part.Position.Y < lowestY then
                    lowestY = part.Position.Y
                    baseX = part.Position.X
                    baseZ = part.Position.Z
                end
            end
        end
    end
    if lowestY == math.huge then return myPlot:GetPivot().Position end
    return Vector3.new(baseX, lowestY + 3, baseZ)
end

local ROAD_KEYWORDS = { "road", "path", "street", "walkway", "sidewalk" }
local function findNearbyRoad(fromPos)
    local candidates = {}
    local function scan(obj)
        if obj:IsA("BasePart") then
            local n = obj.Name:lower()
            for _, kw in ipairs(ROAD_KEYWORDS) do
                if n:find(kw) and obj.Size.Magnitude > 30 then
                    table.insert(candidates, obj); return
                end
            end
        end
    end
    for _, obj in ipairs(workspace:GetChildren()) do
        scan(obj)
        if obj:IsA("Model") or obj:IsA("Folder") then
            for _, child in ipairs(obj:GetChildren()) do scan(child) end
        end
    end
    local closest, closestDist = nil, 500
    for _, part in ipairs(candidates) do
        local d = (part.Position - fromPos).Magnitude
        if d > 5 and d < closestDist then closestDist = d; closest = part end
    end
    return closest
end

local function getPlotDoorPosition(myPlot)
    if not myPlot then return nil end
    for _, d in ipairs(myPlot:GetDescendants()) do
        if d:IsA("SpawnLocation") then
            return d.Position + Vector3.new(0, 3, 0)
        end
    end
    local doorKeywords = { "door", "entrance", "spawn", "gate", "exit", "front" }
    for _, d in ipairs(myPlot:GetDescendants()) do
        if d:IsA("BasePart") then
            local n = d.Name:lower()
            for _, kw in ipairs(doorKeywords) do
                if n:find(kw) then
                    local sz = d.Size.Magnitude
                    if sz > 0.5 and sz < 50 then
                        return d.Position + Vector3.new(0, 3, 0)
                    end
                end
            end
        end
    end
    local plotPos = myPlot:GetPivot().Position
    local road = findNearbyRoad(plotPos)
    if road then
        local roadDir = road.Position - plotPos
        roadDir = Vector3.new(roadDir.X, 0, roadDir.Z)
        if roadDir.Magnitude > 1 then
            roadDir = roadDir.Unit
            local bestPart, bestProj = nil, -math.huge
            for _, d in ipairs(myPlot:GetDescendants()) do
                if d:IsA("BasePart") and d.Size.Y < 8 and d.Size.Magnitude > 2 then
                    local rel = d.Position - plotPos
                    local proj = Vector3.new(rel.X, 0, rel.Z):Dot(roadDir)
                    if proj > bestProj then bestProj = proj; bestPart = d end
                end
            end
            if bestPart then
                return bestPart.Position + Vector3.new(0, 3, 0)
            end
        end
    end
    return getPlotFloor(myPlot)
end

local function getGroundY(posX, posZ)
    local rayParams = RaycastParams.new()
    rayParams.FilterType = Enum.RaycastFilterType.Exclude
    rayParams.FilterDescendantsInstances = { LP.Character, workspace:FindFirstChild("Plots") }
    local result = workspace:Raycast(Vector3.new(posX, 1000, posZ), Vector3.new(0, -2000, 0), rayParams)
    if result then return result.Position.Y end
