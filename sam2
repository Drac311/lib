local function isInFusion(model)
    if not model or not model.Parent then return true end
    if model:GetAttribute("InFusion") or model:GetAttribute("Fusing") then return true end
    local parent = model.Parent
    local depth = 0
    while parent and parent ~= workspace and depth < 5 do
        local pName = parent.Name:lower()
        if pName:find("fusion") or pName:find("fusing") or pName:find("machine") then
            return true
        end
        parent = parent.Parent
        depth = depth + 1
    end
    local partCount = 0
    local transparentCount = 0
    for _, p in ipairs(model:GetDescendants()) do
        if p:IsA("BasePart") then
            partCount = partCount + 1
            if p.Transparency > 0.1 and p.Transparency < 0.99 then
                transparentCount = transparentCount + 1
            end
        end
    end
    if partCount > 0 and (transparentCount / partCount) > 0.3 then
        return true
    end
    local prompt = model:FindFirstChildWhichIsA("ProximityPrompt", true)
    if prompt and not prompt.Enabled then
        return true
    end
    for _, d in ipairs(model:GetDescendants()) do
        if d:IsA("TextLabel") or d:IsA("TextButton") then
            local txt = tostring(d.Text or ""):lower()
            if txt:find("fusing") or txt:find("fusion") then
                return true
            end
        end
    end
    return false
end

local function findBestBrainrot(rankMode, minThreshold)
    rankMode = rankMode or S.rankingMode or "value"
    local myPlot = getMyPlot()
    local plotsFolder = workspace:FindFirstChild("Plots")
    if not plotsFolder then return nil, 0 end
    local bestScore, bestEntry = -1, nil
    for _, plot in ipairs(plotsFolder:GetChildren()) do
        if plot ~= myPlot and plot:GetAttribute("Player") ~= LP.Name then
            local podiums = plot:FindFirstChild("AnimalPodiums")
            if podiums then
                for _, podium in ipairs(podiums:GetChildren()) do
                    local base = podium:FindFirstChild("Base")
                    local spawn = base and base:FindFirstChild("Spawn")
                    local att = spawn and spawn:FindFirstChild("PromptAttachment")
                    local prompt = att and att:FindFirstChildOfClass("ProximityPrompt")
                    if prompt and prompt.Enabled and ((prompt.ActionText or ""):lower():find("steal")) then
                        local bName = prompt.ObjectText or ""
                        local model = nil
                        local slotNum = tonumber(podium.Name)
                        for _, m in ipairs(plot:GetChildren()) do
                            if m:IsA("Model") and m.Name==bName then
                                local mSlot = m:GetAttribute("__PodiumSlot")
                                if mSlot==nil or mSlot==slotNum or tostring(mSlot)==podium.Name then
                                    model=m; break
                                end
                            end
                        end
                        if not model then model = plot:FindFirstChild(bName) end
                        if model and not isInFusion(model) then
                            local score = (rankMode=="income") and getBrainrotIncome(model) or getBrainrotValue(model)
                            local passFilter = true
                            if minThreshold then
                                local hs = getHopScore(model)
                                if hs < minThreshold then passFilter = false end
                            end
                            if passFilter and score > bestScore then
                                bestScore = score
                                bestEntry = {
                                    plot=plot, podium=podium, prompt=prompt, spawn=spawn,
                                    model=model, pos=spawn.Position, name=bName,
                                    owner=plot:GetAttribute("Player") or "?", score=score,
                                }
                            end
                        end
                    end
                end
            end
        end
    end
    return bestEntry, bestScore
end

