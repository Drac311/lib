local function sendWebhook(brainrotName, value, income)
    if not S.webhookUrl or S.webhookUrl == "" then
        warn("[Draxi Webhook] URL vacía."); return
    end
    local url = string.gsub(S.webhookUrl, "%s+", "")
    if not string.find(url, "discord.com/api/webhooks") then
        warn("[Draxi Webhook] URL inválida."); return
    end
    local req = syn and syn.request or http and http.request or http_request or request
    if not req then warn("[Draxi Webhook] Executor sin request."); return end
    local payload = {
        ["content"] = "🎉 **¡Brainrot de Alto Valor Encontrado!**",
        ["embeds"] = {{
            ["title"] = "🎯 Detalles del Brainrot",
            ["color"] = 65280,
            ["fields"] = {
                { ["name"] = "🧠 Brainrot", ["value"] = "**"..tostring(brainrotName).."**", ["inline"] = true },
                { ["name"] = "💰 Valor", "value"] = formatNumber(value), ["inline"] = true },
                { ["name"] = "💵 Dinero/Seg", ["value"] = formatNumber(income), ["inline"] = true }
            },
            ["footer"] = { ["text"] = "Draxi Script • " .. os.date("%X") }
        }}
    }
    local success, response = pcall(function()
        return req({
            Url = url, Method = "POST",
            Headers = {
                ["Content-Type"] = "application/json",
                ["User-Agent"] = "Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/120.0.0.0 Safari/537.36"
            },
            Body = HttpService:JSONEncode(payload)
        })
    end)
    if not success then warn("[Draxi Webhook] " .. tostring(response))
    elseif response.StatusCode == 204 or response.StatusCode == 200 then
        print("[Draxi Webhook] Enviado! " .. tostring(response.StatusCode))
    else warn("[Draxi Webhook] Rechazado: " .. tostring(response.StatusCode)) end
end

