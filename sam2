local function findBestBrainrot(mode)
    mode = mode or S.rankingMode or "value"
    local myPlot = getMyPlot()
    local plotsFolder = workspace:FindFirstChild("Plots")
    if not plotsFolder then return nil, 0 end
    local bestScore, bestEntry = -1, nil
    for _, plot in ipairs(plotsFolder:GetChildren()) do
        if plot ~= myPlot and plot:GetAttribute("Player") ~= LP.Name then
            local podiums = plot:FindFirstChild("AnimalPodiums")
            if podiums then
                for _, podium in ipairs(podiums:GetChildren()) do
                    local base = podium:FindFirstChild("Base")
                    local spawn = base and base:FindFirstChild("Spawn")
                    local att = spawn and spawn:FindFirstChild("PromptAttachment")
                    local prompt = att and att:FindFirstChildOfClass("ProximityPrompt")
                    if prompt and prompt.Enabled and ((prompt.ActionText or ""):lower():find("steal")) then
                        local bName = prompt.ObjectText or ""
                        local model = nil
                        local slotNum = tonumber(podium.Name)
                        for _, m in ipairs(plot:GetChildren()) do
                            if m:IsA("Model") and m.Name==bName then
                                local mSlot = m:GetAttribute("__PodiumSlot")
                                if mSlot==nil or mSlot==slotNum or tostring(mSlot)==podium.Name then
                                    model=m; break
                                end
                            end
                        end
                        if not model then model = plot:FindFirstChild(bName) end
                        if model and not isInFusion(model) then
                            local score = (mode=="income") and getBrainrotIncome(model) or getBrainrotValue(model)
                            if score > bestScore then
                                bestScore = score
                                bestEntry = {
                                    plot=plot, podium=podium, prompt=prompt, spawn=spawn,
                                    model=model, pos=spawn.Position, name=bName,
                                    owner=plot:GetAttribute("Player") or "?", score=score,
                                }
                            end
                        end
                    end
                end
            end
        end
    end
    return bestEntry, bestScore
end

