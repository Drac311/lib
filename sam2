                                elseif target:IsA("BasePart") then target.CFrame = newCFrame end
                                for _, desc in ipairs(target:GetDescendants()) do
                                    if desc:IsA("BasePart") then
                                        desc.Transparency = 1; desc.CanCollide = false; desc.CanTouch = true; desc.Massless = true
                                    elseif desc:IsA("BillboardGui") or desc:IsA("SurfaceGui") then
                                        desc.Enabled = false
                                    end
                                end
                            end
                        end
                    end
                end
            end
        end
    end
end)

-- ── Server Hop ───────────────────────────────────────────────
local function HopServer()
    Window:Notify({ Title = "Server Hop", Content = "Buscando servidor...", Duration = 3 })
    local servers = game:HttpGet("https://games.roblox.com/v1/games/"..game.PlaceId.."/servers/Public?sortOrder=Asc&limit=100")
    local decoded = HttpService:JSONDecode(servers)
    local availableServers = {}
    for _, srv in ipairs(decoded.data) do
        if srv.playing < srv.maxPlayers and srv.id ~= game.JobId then table.insert(availableServers, srv.id) end
    end
    if #availableServers > 0 then
        local chosenServer = availableServers[math.random(1, #availableServers)]
        pcall(function() TS:TeleportToPlaceInstance(game.PlaceId, chosenServer, LP) end)
    else
        Window:Notify({ Title = "Server Hop", Content = "Sin servidores disponibles.", Duration = 3 })
        isHopping = false
    end
end

-- ── Vuelo interpolado ───────────────────────────────────────
local function FlyTo(targetPos, speed, cancelCheck)
    local char = LP.Character
    if not char or not char:FindFirstChild("HumanoidRootPart") then return end
    local hrp = char.HumanoidRootPart
    local startPos = hrp.Position
    local dist = (targetPos - startPos).Magnitude
    local duration = math.clamp(dist / speed, 0.5, 4)
    local startTime = tick()
    local conn
    conn = RunSvc.RenderStepped:Connect(function()
        if cancelCheck and not cancelCheck() then conn:Disconnect(); return end
        if not char.Parent or not hrp.Parent then if conn then conn:Disconnect() end; return end
        local elapsed = tick() - startTime
        local t = math.clamp(elapsed / duration, 0, 1)
        char:PivotTo(CFrame.new(startPos:Lerp(targetPos, t)))
        if t >= 1 then conn:Disconnect() end
    end)
    while conn.Connected do task.wait() end
end

-- ── Teleport con retry ──────────────────────────────────────
local function teleportAndVerify(hrp, targetPos)
    local offsets = { 3, 5, 2, 7, 4, 6 }
    for i, y in ipairs(offsets) do
        hrp.AssemblyLinearVelocity = Vector3.zero
        hrp.CFrame = CFrame.new(targetPos + Vector3.new(0, y, 0))
        task.wait(0.25)
        local dist = (hrp.Position - targetPos).Magnitude
        print(string.format("[Draxi] TP try %d (Y+%d) → dist=%.1f", i, y, dist))
        if dist <= 12 then return dist end
    end
    return (hrp.Position - targetPos).Magnitude
end

-- ── Secuencia de robo (E-hold + fallback prompt) ───────────
local function PerformStealSequence(autoGrab, loopMode)
    if isStealing then return nil end
    isStealing = true

    local originalNoclip    = S.noclipActive
    local originalRagdoll   = S.antiRagdoll
    local originalKnockback = S.antiKnockback

    S.noclipActive = true
    S.antiRagdoll = true
    S.antiKnockback = true
    if _noclipToggle    then _noclipToggle:Set(true, true) end
    if _ragdollToggle   then _ragdollToggle:Set(true, true) end
    if _knockbackToggle then _knockbackToggle:Set(true, true) end

    local char = LP.Character
    local hrp  = char and char:FindFirstChild("HumanoidRootPart")

    local function Cleanup()
        S.noclipActive    = originalNoclip
        S.antiRagdoll     = originalRagdoll
        S.antiKnockback   = originalKnockback

        if _noclipToggle    then _noclipToggle:Set(originalNoclip, true) end
        if _ragdollToggle   then _ragdollToggle:Set(originalRagdoll, true) end
        if _knockbackToggle then _knockbackToggle:Set(originalKnockback, true) end

        if char and char:FindFirstChild("HumanoidRootPart") then
            char.HumanoidRootPart.Anchored = false
        end

        isStealing = false

        if not loopMode then
            S.autoSteal = false
            if S.stealMode == "v1" and _autoStealToggle   then _autoStealToggle:Set(false, true) end
            if S.stealMode == "v2" and _autoStealV2Toggle then _autoStealV2Toggle:Set(false, true) end
            S.stealMode = nil
        end
    end

    if not hrp then return Cleanup() end

    local baseCFrame = hrp.CFrame
    S.myBasePos = baseCFrame.Position

    local entry = findBestBrainrot(S.rankingMode or "value")
    if not entry then
        Window:Notify({ Title = "Auto Steal", Content = "No se encontró Brainrot.", Duration = 2 })
        return Cleanup()
    end

    Window:Notify({ Title = "Auto Steal",
        Content = "→ "..entry.name.." (de "..entry.owner..")", Duration = 2 })

    if not S.autoSteal then return Cleanup() end

    -- Teleport
    hrp.Anchored = true
    teleportAndVerify(hrp, entry.pos)
    task.wait(0.4)
    if not S.autoSteal then return Cleanup() end

    if autoGrab then
        -- Simular E hold
        local method = simulateEHold((entry.prompt.HoldDuration or 1.5) + 0.2)
        print("[Draxi] E-hold method: " .. tostring(method))
        task.wait(0.4)
    else
        -- V1 manual
        hrp.Anchored = false
        Window:Notify({ Title = "Auto Steal", Content = "Coge y pulsa [PASO 2]", Duration = 10 })
        local clickedConfirm = false
        local conn
        conn = confirmGrabEvent.Event:Connect(function() clickedConfirm = true end)
        local timeout = 30
        while not clickedConfirm and timeout > 0 do
            if not S.autoSteal then conn:Disconnect(); return Cleanup() end
            task.wait(0.1)
            timeout = timeout - 0.1
        end
        conn:Disconnect()
        if not clickedConfirm then
            Window:Notify({ Title = "Auto Steal", Content = "Timeout", Duration = 3 })
            return Cleanup()
        end
        hrp.Anchored = true
    end

    if not S.autoSteal then return Cleanup() end

    -- Volver a base
    hrp.AssemblyLinearVelocity = Vector3.zero
    hrp.CFrame = baseCFrame
    task.wait(0.4)

    hrp.Anchored = false
    Cleanup()
end

